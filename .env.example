# Site name used by the production Compose services.
SITE_NAME=support
SITE_DB_NAME=support_db
# bench uses SITE_DB_NAME as the database user,
# so if site_db_name is db1234 then site_db_user is db1234
SITE_DB_PASSWORD=HlNTiPlA6FUmrOer
# Default production site.

# Frappe administrator login password. Replace with a unique, strong secret
# before production use; this value is also used when the site is first created.
ADMIN_PASSWORD=admin123

# MariaDB root credentials. Compose requires both variables and passes the
# MariaDB password to Frappe for site creation; keep these values identical.
MYSQL_ROOT_PASSWORD=admin123
MARIADB_ROOT_PASSWORD=admin123

# Container timezone; affects timestamps and the scheduled backup time.
TZ=Africa/Nairobi

# Database connection used by the Frappe containers.
DB_HOST=mariadb-db
DB_PORT=3306
# MariaDB administrative account used by site creation and destructive reinstall.
DB_ROOT_USER=root

# Redis service addresses used by Frappe for cache, queue, and Socket.IO.
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379

# Gunicorn concurrency and request timeout. Tune for available CPU and memory.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Reverse-proxy client-IP handling. Set the trusted proxy address/header to
# match your host proxy; recursive is usually off unless proxy chains require it.
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
# Nginx timeout for proxied requests and maximum accepted request body size.
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Host port published for the Frappe frontend (container port is 8080).
FRONTEND_EXT_HTTP_PORT=8000

# Daily backup schedule in five-field cron format: minute hour day month weekday.
BACKUP_CRON_SCHEDULE="*/6 * * * *"

# Startup readiness time limits, in seconds, for dependencies and services.
DEPENDENCIES_STARTUP_TIMEOUT=180
BACKEND_STARTUP_TIMEOUT=180
WEBSOCKET_STARTUP_TIMEOUT=180

# Refresh codebase apps
REFRESH_CODEBASE_APPS="kustomize,tiksupport"

# To guide during the installation
# Official Apps
# bench get-app telephony
# bench get-app helpdesk --branch main
# bench --site support install-app telephony helpdesk

# Custom Apps
# bench setup requirements --node
# bench get-app git@github.com:NgatiaFrankline/frappe-kustomize-app.git --branch main
# bench get-app git@github.com:NgatiaFrankline/frappe-tiksupport.git --branch main
# bench --site support install-app kustomize tiksupport

# bench --site support migrate
# bench build
# bench --site support clear-cache
# bench --site support clear-website-cache

